<Window x:Class="LibraryCollege.CommandsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Команды" Height="500" Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Название:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="0,0,10,0"/>
            <TextBlock Text="Автор:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox Text="{Binding NewAuthor, UpdateSourceTrigger=PropertyChanged}" Width="150" Margin="0,0,10,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Добавить" Command="{Binding AddCommand}" Width="100" Height="28" Margin="0,0,10,0"/>
            <Button Content="Удалить выбранную" Command="{Binding DeleteCommand}"
                    CommandParameter="{Binding SelectedItem, ElementName=GridBooks}" Width="150" Height="28" Margin="0,0,10,0"/>
            <Button Content="Очистить всё" Command="{Binding ClearCommand}" Width="120" Height="28"/>
        </StackPanel>

        <DataGrid Grid.Row="2" x:Name="GridBooks" ItemsSource="{Binding Books}"
                  SelectedItem="{Binding SelectedBook}"
                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="*"/>
                <DataGridTextColumn Header="Автор" Binding="{Binding Author}" Width="200"/>
                <DataGridTextColumn Header="Год" Binding="{Binding Year}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>