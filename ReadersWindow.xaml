<Window x:Class="LibraryCollege.ReadersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Читатели" Height="450" Width="600"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="ФИО:" VerticalAlignment="Center" Width="60"/>
            <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" Width="300"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Группа:" VerticalAlignment="Center" Width="60"/>
            <TextBox Text="{Binding Group, UpdateSourceTrigger=PropertyChanged}" Width="300"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Рейтинг:" VerticalAlignment="Center" Width="60"/>
            <Slider Value="{Binding Rating}" Minimum="0" Maximum="100" Width="300" 
                    TickFrequency="10" IsSnapToTickEnabled="True"/>
        </StackPanel>

        <CheckBox Grid.Row="3" Content="Активен"
                  IsChecked="{Binding IsActive}" Margin="0,0,0,15"/>

        <Border Grid.Row="4" BorderBrush="Gray" BorderThickness="1" Padding="10">
            <StackPanel>
                <TextBlock Text="Предпросмотр:" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBlock Text="{Binding FullName, StringFormat='ФИО: {0}'}"/>
                <TextBlock Text="{Binding Group, StringFormat='Группа: {0}'}"/>
                <TextBlock Text="{Binding Rating, StringFormat='Рейтинг: {0}/100'}"/>
                <TextBlock Text="{Binding IsActive, StringFormat='Активен: {0}'}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>