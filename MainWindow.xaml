<Window x:Class="LibraryCollege.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Библиотека колледжа — Главное меню"
        Height="500" Width="700"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

            <Viewbox Width="80" Height="80" HorizontalAlignment="Center" Margin="0,0,0,15">
                <Canvas Width="24" Height="24">
                    <Path Fill="#2C3E50" Data="M4 6H2v14c0 1.1.9 2 2 2h14v-2H4V6zm16-4H8c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H8V4h12v12z"/>
                </Canvas>
            </Viewbox>

            <TextBlock Text="Добро пожаловать!" FontSize="28" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Center" Margin="0,0,0,25"/>

            <!-- Кнопки перехода в разные окна практических работ -->
            <Button Content="Книги (Практика 3)" Width="220" Height="40" Margin="0,0,0,10" 
                    Style="{StaticResource PrimaryButton}" Click="BtnBooks_Click"/>

            <Button Content="Читатели (Практика 7)" Width="220" Height="40" Margin="0,0,0,10" 
                    Style="{StaticResource PrimaryButton}" Click="BtnReaders_Click"/>

            <Button Content="Карточки (Практика 4)" Width="220" Height="40" Margin="0,0,0,10" 
                    Style="{StaticResource PrimaryButton}" Click="BtnCards_Click"/>

            <Button Content="MVP Команды (Практика 10)" Width="220" Height="40" Margin="0,0,0,10" 
                    Style="{StaticResource PrimaryButton}" Click="BtnToolkit_Click"/>

            <Button Content="Выход" Width="220" Height="40" Margin="0,20,0,0" 
                    Style="{StaticResource PrimaryButton}" Click="BtnExit_Click"/>
        </StackPanel>
    </Grid>
</Window>