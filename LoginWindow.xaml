<Window x:Class="LibraryCollege.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация — Библиотека колледжа"
        Height="400" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Библиотека колледжа"
                   Style="{StaticResource HeaderText}"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,30"/>

        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <TextBlock Text="Логин:" Margin="0,0,0,5" FontWeight="SemiBold"/>
            <TextBox x:Name="TxtLogin"/>

            <TextBlock Text="Пароль:" Margin="0,15,0,5" FontWeight="SemiBold"/>
            <PasswordBox x:Name="TxtPassword"/>

            <CheckBox Content="Запомнить меня" Margin="0,15,0,0"/>

            <Button Content="Войти" Height="40" Margin="0,20,0,0"
                    Style="{StaticResource PrimaryButton}"
                    FontSize="16" Click="BtnLogin_Click"/>
        </StackPanel>
    </Grid>
</Window>
