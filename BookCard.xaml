<UserControl x:Class="LibraryCollege.BookCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="6"
            Padding="10" Margin="5" Background="#F8F9FA">
        <StackPanel>
            <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       FontSize="16" FontWeight="Bold" Foreground="#2C3E50"/>
            <TextBlock Text="{Binding Author, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       FontSize="13" Foreground="#7F8C8D" Margin="0,5,0,0"/>
            <TextBlock Text="{Binding Year, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat='Год: {0}'}"
                       FontSize="12" Foreground="#95A5A6" Margin="0,3,0,0"/>
        </StackPanel>
    </Border>
</UserControl>