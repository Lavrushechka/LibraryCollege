<Window x:Class="LibraryCollege.BookWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Учёт книг" Height="500" Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="Название:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="TxtTitle" Width="200" Height="28" Margin="0,0,10,0"/>

            <TextBlock Text="Автор:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="TxtAuthor" Width="150" Height="28" Margin="0,0,10,0"/>

            <TextBlock Text="Год:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <DatePicker x:Name="DpYear" Width="120" Height="28" Margin="0,0,10,0"/>

            <Button Content="Добавить" Width="100" Height="28" Click="BtnAdd_Click" Margin="0,0,10,0"/>
            <Button Content="Удалить" Width="100" Height="28" Click="BtnDelete_Click"/>
        </StackPanel>

        <DataGrid Grid.Row="1" x:Name="GridBooks" AutoGenerateColumns="False"
                  CanUserAddRows="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="*"/>
                <DataGridTextColumn Header="Автор" Binding="{Binding Author}" Width="200"/>
                <DataGridTextColumn Header="Год" Binding="{Binding Year}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>